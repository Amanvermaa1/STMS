# Copy to .env before running locally.
# For Docker Compose, the API service overrides the host to "postgres".
DATABASE_URL="postgresql://stms:stms@localhost:5432/stms"

# Supabase: set DATABASE_URL to the Transaction pooler (port 6543) for the API,
# and DATABASE_MIGRATION_URL to the Session pooler / direct connection (port 5432).
# Both should include ?sslmode=require. With node-postgres v8, also add
# &uselibpqcompat=true so `require` means encryption without failing on the
# Supabase pooler certificate chain.
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
# DATABASE_MIGRATION_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"
# DATABASE_MIGRATION_URL falls back to DATABASE_URL when omitted.

PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN="http://localhost:5173"

# WebAuthn / passkeys. Use your real domain and HTTPS origins in production.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="STMS Helpdesk"
WEBAUTHN_ORIGINS="http://localhost:5173,http://localhost:8080"

# Seed admin (used by: npm run db:seed)
ADMIN_EMAIL="admin@stms.local"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="Helpdesk Admin"

# Optional SMTP email notifications. Leave empty to disable.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Helpdesk <no-reply@stms.local>"
